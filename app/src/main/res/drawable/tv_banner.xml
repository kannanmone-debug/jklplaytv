<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size
                android:width="320dp"
                android:height="180dp" />
            <gradient
                android:angle="135"
                android:startColor="#02040A"
                android:centerColor="#0E1526"
                android:endColor="#0284C7" />
        </shape>
    </item>
    <item
        android:width="96dp"
        android:height="96dp"
        android:gravity="center">
        <bitmap
            android:gravity="center"
            android:src="@drawable/ic_launcher_jkl_foreground" />
    </item>
</layer-list>
